{
  "name": "roadmap-receipts-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "node scripts/sync_deployments.mjs",
    "sync:evidence": "node scripts/sync_evidence.mjs",
    "verify:contracts": "node scripts/verify_contracts.mjs",
    "scan:banned": "node scripts/scan_banned.mjs",
    "scan:gradients": "node scripts/scan_gradients.mjs",
    "scan:contrast": "node scripts/scan_contrast.mjs",
    "e2e:chain": "tsx scripts/e2e_full_chain.mjs",
    "screens:capture": "node scripts/capture_screenshots.mjs",
    "audit:deployed": "node scripts/audit_deployed_url.mjs",
    "report": "tsx scripts/generate_final_report.ts",
    "check": "npm run build && npm run test && npm run scan:banned && npm run scan:gradients && npm run scan:contrast"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
